# FAMA 2.0 — przykładowa konfiguracja. Skopiuj do `.env` i odkomentuj to, czego używasz.
# Plik `.env` jest w .gitignore — klucze nie trafią do repozytorium.

# ---------------------------------------------------------------- lokalny LLM
# Dowolny serwer zgodny z OpenAI API. Modele odkrywane są automatycznie (/v1/models),
# klucz API nie jest wymagany. Koszt szacowany jako ~0 (lokalnie).
#
# Ollama:          OPENAI_BASE_URL=http://localhost:11434/v1
# LM Studio:       OPENAI_BASE_URL=http://localhost:1234/v1
# llama.cpp (llama-server): OPENAI_BASE_URL=http://localhost:8080/v1
# vLLM:            OPENAI_BASE_URL=http://localhost:8001/v1
#
# OPENAI_BASE_URL=http://localhost:11434/v1
# (opcjonalnie, gdy endpoint nie udostępnia /v1/models:)
# FAMA_COMPAT_DEFAULT_MODEL=qwen2.5-coder:7b

# ---------------------------------------------------------------- OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...

# ---------------------------------------------------------------- OpenAI / Anthropic
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------- research (opcjonalnie)
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...

# ---------------------------------------------------------------- własne modele
# format: provider:model_id:klasy:cena_in:cena_out (za Mtok); klasy: cheap fast reasoning coding adversarial local vision
# FAMA_MODELS=openai_compatible:my-model:fast+cheap:0.1:0.2
